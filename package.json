{
  "name": "avalon-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test apps/server/test/*.test.ts apps/web/test/*.test.ts packages/game-core/test/*.test.ts scripts/deploy/*.test.mjs",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "build:server": "node scripts/build-server.mjs",
    "deploy:setup": "node scripts/setup-deployment.mjs",
    "deploy:tunnel:setup": "node scripts/setup-tunnel.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:backup": "node scripts/deploy/backup.mjs",
    "deploy:restore": "node scripts/deploy/restore.mjs",
    "deploy:rehearse": "node scripts/deploy/rehearse.mjs",
    "deploy:friends:smoke": "node scripts/deploy/friends-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.1",
    "@radix-ui/react-label": "2.1.15",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "ws": "8.22.0"
  }
}
