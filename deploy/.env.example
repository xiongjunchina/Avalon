# Reference only. setup-deployment generates a private .env.local without overwriting.
PROJECT=avalon-stage7-local
APP_ORIGIN=http://127.0.0.1:8088
GATEWAY_PORT=8088
COOKIE_SECURE=false
TLS_DIRECTIVE=
POSTGRES_PASSWORD=generate_with_deploy_setup
IMAGE_TAG=stage7
# Set these only in the private deploy/.env.<instance> file on the server.
WECHAT_MINIGAME_APP_ID=
WECHAT_MINIGAME_APP_SECRET=
# Private administrator password. Blank disables administrator access; no default password exists.
ADMIN_KEY=
NODE_IMAGE=node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
CADDY_IMAGE=caddy:2-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
POSTGRES_IMAGE=postgres:18.4-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
