# Not consumed by the local wrapper. Copy to a private .env file on the approved host.
PROJECT=avalon-friends
APP_ORIGIN=https://game.example.com
GATEWAY_PORT=443
COOKIE_SECURE=true
TLS_DIRECTIVE=
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
IMAGE_TAG=stage7
# Set only in the private server-side copy; never commit the AppSecret.
WECHAT_MINIGAME_APP_ID=
WECHAT_MINIGAME_APP_SECRET=
# Pinned base images default to deploy/compose.yaml. Keep the exact release images.
